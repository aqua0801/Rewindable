<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Authors>Aqua0801</Authors>
    <!-- Keep in sync with unity/com.aqua0801.rewindable/package.json (PackageTests checks it). -->
    <Version>0.5.0</Version>
    <UnityPackageDir>$(MSBuildThisFileDirectory)unity\com.aqua0801.rewindable\</UnityPackageDir>
  </PropertyGroup>

  <!-- NuGet metadata shared by the packable projects (Rewindable, Rewindable.Cli). -->
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Aqua0801</Copyright>
    <PackageProjectUrl>https://github.com/aqua0801/Rewindable</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aqua0801/Rewindable</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Library projects: ship XML docs for IntelliSense (missing-doc warnings suppressed). -->
  <PropertyGroup Condition="'$(MSBuildProjectName.EndsWith(`.Tests`))' != 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Any project whose name ends with ".Tests" is a test project. -->
  <PropertyGroup Condition="'$(MSBuildProjectName.EndsWith(`.Tests`))' == 'true'">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

</Project>
